# Leave GEMINI_API_KEY empty to run in MOCK mode (sample worksheets + template tutor).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Seconds before a Gemini call is abandoned (the robot says "that took too long" / uses a template)
GEMINI_TIMEOUT=25
# Thinking level for reading the worksheet: minimal | low | medium | high (empty = model default)
GEMINI_VISION_THINKING=low
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
